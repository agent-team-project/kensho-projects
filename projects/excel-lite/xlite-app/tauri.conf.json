{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excel Lite",
  "version": "0.1.0",
  "identifier": "dev.kensho.excellite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Excel Lite",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": ["../examples/first-run-sample.xlite"]
  }
}
