{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["svelte", "vite/client", "vitest/globals"],
    "useDefineForClassFields": true
  },
  "include": ["svelte.config.js", "vite.config.ts", "vitest.config.ts", "ui/src/**/*.svelte", "ui/src/**/*.ts"]
}
