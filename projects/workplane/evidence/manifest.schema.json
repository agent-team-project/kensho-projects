{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workplane.local/schemas/evidence-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_commit", "dirty", "suite", "environment", "started_at", "finished_at", "summary", "gates"],
  "properties": {
    "schema_version": {"const": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirty": {"const": false},
    "suite": {"type": "string", "enum": ["smoke", "acceptance", "release"]},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "hardware", "python", "go", "node", "docker"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "hardware": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "go": {"type": "string", "minLength": 1},
        "node": {"type": "string", "minLength": 1},
        "docker": {"type": "string", "minLength": 1}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gates", "command_executions", "passed", "failed"],
      "properties": {
        "gates": {"type": "integer", "minimum": 1},
        "command_executions": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "started_at", "finished_at", "result", "command_executions", "artifacts"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "result": {"type": "string", "enum": ["pass", "fail"]},
          "command_executions": {"const": 1},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
