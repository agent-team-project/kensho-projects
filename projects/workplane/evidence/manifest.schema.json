{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_commit", "dirty", "suite", "environment", "started_at", "finished_at", "gates"],
  "properties": {
    "schema_version": {"const": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirty": {"const": false},
    "suite": {"type": "string", "enum": ["smoke", "acceptance", "release"]},
    "environment": {"type": "object", "minProperties": 2},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command", "started_at", "finished_at", "result", "tests", "artifacts"]
      }
    }
  }
}
